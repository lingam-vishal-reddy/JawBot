# Copy to .env (git-ignored). Loaded at startup from the repo root or cwd.
# Real environment variables always take precedence over values here.

# Server
# JAWBOT_PORT=8787
# JAWBOT_HOST=0.0.0.0
# DISPLAY=:1

# Skills folder (defaults to <repo-root>/skills)
# JAWBOT_SKILLS_DIR=./skills

# Planner selection: heuristic (default) | openai | beta
# JAWBOT_LLM=heuristic

# OpenAI-compatible client (JAWBOT_LLM=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Beta client (JAWBOT_LLM=beta) — independent, header auth, configurable endpoint
# BETA_OPENAPI_TOKEN=
# BETA_GENERATIVE_AI_CLIENT=
# BETA_BASE_URL=https://api.beta.local/v1
# BETA_PATH=/generate
# BETA_MODEL=beta

# Optional explicit env-file path (otherwise cwd/.env and repo-root/.env)
# JAWBOT_ENV_FILE=/absolute/path/to/.env
